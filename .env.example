# .env olarak kopyalayın; boş bırakılanlar varsayılanı kullanır.

# Veritabanı ve yüklenen dosyaların klasörü
DOC_RAG_DATA=data

# Ollama adresi, embedding ve cevap modelleri
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3
# 14B daha isabetli; 4 GB ekran kartında soru başına ~50 s. Hız için qwen2.5:7b-instruct (~20-35 s).
LLM_MODEL=qwen2.5:14b-instruct-q4_K_M

# Tesseract PATH'te değilse tam yolu (ör. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
