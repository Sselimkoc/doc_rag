# .env olarak kopyalayın; boş bırakılanlar varsayılanı kullanır.

# Veritabanı ve yüklenen dosyaların klasörü
DOC_RAG_DATA=data

# Ollama adresi ve embedding modeli
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3

# Tesseract PATH'te değilse tam yolu (ör. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
